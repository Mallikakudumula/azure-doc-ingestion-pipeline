# local = runs fully offline with mock extractor + SQLite
# azure = uses Document Intelligence, Blob Storage, Service Bus
PIPELINE_MODE=local
DATA_DIR=./data
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=3

# --- Azure Document Intelligence ---
DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
DI_KEY=            # leave empty to use Managed Identity / DefaultAzureCredential
DI_MODEL_ID=prebuilt-invoice

# --- Azure Blob landing zone ---
BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
BLOB_CONTAINER=raw-landing

# --- Service Bus dead-letter sink ---
SERVICEBUS_NAMESPACE=<namespace>.servicebus.windows.net
SERVICEBUS_QUEUE=dead-letter-docs

# --- Microsoft Graph (app registration, client credentials) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=   # in real deployments load from Key Vault
GRAPH_MAILBOX=intake@yourtenant.onmicrosoft.com
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
GRAPH_FOLDER=Incoming

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
